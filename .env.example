# Copy to .env and export these (or set them in your hosting dashboard).
PORT=3000
ADMIN_USERNAME=admin
# If empty, a random admin password is printed in the console on first start.
ADMIN_PASSWORD=
# Optional. If empty, secrets are generated once and stored in data/secrets.json.
# Changing FLAG_SECRET changes EVERY player's flags.
FLAG_SECRET=
JWT_SECRET=
# Set to production behind HTTPS (turns on secure cookies and HSTS).
NODE_ENV=development
# Number of reverse proxies in front of the app (1 behind nginx/Caddy/Render/
# Fly/Railway/a tunnel). Needed so rate limiting sees the real client IP.
TRUST_PROXY=
MAX_GROUP_SIZE=10
SUBMIT_LIMIT_PER_MIN=5
# Minutes ahead of UTC for the daily challenge rollover (330 = India).
DAILY_TZ_OFFSET_MIN=330
